# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CARTO_API_KEY: API key for CARTO Basemaps (Voyager, Dark Matter, Positron).
# The backend server automatically detects this key and proxies all tile requests securely via /api/tiles/carto/*
CARTO_API_KEY="MY_CARTO_API_KEY"

# BASEMAP_API_KEY: Universal fallback key for any basemap provider
BASEMAP_API_KEY=""

# MAPBOX_API_KEY: Optional token for Mapbox basemaps
MAPBOX_API_KEY=""

# MAPTILER_API_KEY: Optional key for MapTiler basemaps
MAPTILER_API_KEY=""
